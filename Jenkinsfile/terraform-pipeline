pipeline {
    agent {
        docker {
            image 'lokeshkanneboina7/devops-agent:latest'
            args '--entrypoint="" -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        AWS_REGION = "ap-south-1"
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/LOKESH734/Real_WORLD_JOB.git'
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    dir('terraform') {
                        sh '''
                        export AWS_DEFAULT_REGION=${AWS_REGION}
                        terraform init -upgrade
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    dir('terraform') {
                        sh '''
                        export AWS_DEFAULT_REGION=${AWS_REGION}
                        terraform plan -out=tfplan || exit 1
                        '''
                    }
                }
            }
        }

        // OPTIONAL (remove if you want auto)
        stage('Approval') {
            steps {
                input message: "Apply Terraform changes?"
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    dir('terraform') {
                        sh '''
                        export AWS_DEFAULT_REGION=${AWS_REGION}
                        terraform apply -auto-approve tfplan
                        '''
                    }
                }
            }
        }

        stage('Trigger App Deployment') {
            steps {
                build job: 'App-Jenkinsfile'
            }
        }
    }

    post {
        success {
            echo "🚀 Infra + App Deployment Successful"
        }
        failure {
            echo "❌ Terraform Pipeline Failed"
        }
    }
}