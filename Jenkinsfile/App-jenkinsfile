pipeline {
    agent {
        docker {
            image 'lokeshkanneboina7/devops-agent:latest'
            args '--entrypoint="" -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        AWS_REGION   = "ap-south-1"
        ACCOUNT_ID   = "730024653391"
        CLUSTER_NAME = "realworld-eks"
        ECR_REGISTRY = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()
                git branch: 'main',
                    url: 'https://github.com/LOKESH734/Real_WORLD_JOB.git'
            }
        }

        stage('Set Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    echo "IMAGE_TAG = ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Ensure ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh '''
                    for repo in backend frontend; do
                        aws ecr describe-repositories --repository-names $repo --region ${AWS_REGION} >/dev/null 2>&1 \
                        || aws ecr create-repository --repository-name $repo --region ${AWS_REGION}
                    done
                    '''
                }
            }
        }

        // 🔥 BUILD
        stage('Build Images') {
            steps {
                sh '''
                docker build -t backend:${IMAGE_TAG} realWordJob
                docker build -t frontend:${IMAGE_TAG} job-portal-frontend69
                '''
            }
        }

        // 🔥 PUSH (NO latest)
        stage('Push Images') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh '''
                    aws ecr get-login-password --region ${AWS_REGION} \
                    | docker login --username AWS --password-stdin ${ECR_REGISTRY}

                    docker tag backend:${IMAGE_TAG} ${ECR_REGISTRY}/backend:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/backend:${IMAGE_TAG}

                    docker tag frontend:${IMAGE_TAG} ${ECR_REGISTRY}/frontend:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/frontend:${IMAGE_TAG}
                    '''
                }
            }
        }

        // 🔥 CONNECT CLUSTER
        stage('Connect EKS') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh '''
                    aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}
                    '''
                }
            }
        }

        // 🔥 APPLY ONLY ONCE SAFE MANIFESTS
        stage('Apply Base Resources') {
            steps {
                sh '''
                kubectl apply -f K8s/mysql.yaml || true
                kubectl apply -f K8s/backend.yaml || true
                kubectl apply -f K8s/frontend.yaml || true
                kubectl apply -f K8s/ingress.yaml || true
                '''
            }
        }

        // 🔥 WAIT FOR MYSQL (CRITICAL FIX)
        stage('Wait for MySQL') {
            steps {
                sh '''
                echo "Waiting for MySQL..."
                for i in $(seq 1 30); do
                    STATUS=$(kubectl get pods -l app=mysql -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "")
                    if [ "$STATUS" = "Running" ]; then
                        echo "MySQL is running ✅"
                        exit 0
                    fi
                    echo "Waiting for MySQL... $i/30"
                    sleep 10
                done
                echo "MySQL failed to start ❌"
                kubectl get pods
                exit 1
                '''
            }
        }

        // 🔥 UPDATE IMAGES
        stage('Deploy New Version') {
            steps {
                sh '''
                kubectl set image deployment/backend backend=${ECR_REGISTRY}/backend:${IMAGE_TAG}
                kubectl set image deployment/frontend frontend=${ECR_REGISTRY}/frontend:${IMAGE_TAG}
                '''
            }
        }

        // 🔥 ROLLOUT
        stage('Verify Deployment') {
            steps {
                sh '''
                kubectl rollout status deployment/backend --timeout=300s
                kubectl rollout status deployment/frontend --timeout=300s
                '''
            }
        }

        // 🔥 FINAL CHECK
        stage('Final Status') {
            steps {
                sh '''
                echo "Pods:"
                kubectl get pods -o wide

                echo "Services:"
                kubectl get svc
                '''
            }
        }

        // 🔥 GET URL
        stage('Get URL') {
            steps {
                sh '''
                for i in $(seq 1 40); do
                    URL=$(kubectl get ingress app-ingress \
                        -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' \
                        2>/dev/null || echo "")

                    if [ -n "$URL" ]; then
                        echo "APP URL: http://$URL"
                        exit 0
                    fi
                    echo "Waiting for ALB... $i/40"
                    sleep 15
                done
                echo "ALB not ready"
                exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "✅ PIPELINE SUCCESS - App is LIVE"
        }
        failure {
            echo "❌ PIPELINE FAILED - Check logs"
        }
    }
}