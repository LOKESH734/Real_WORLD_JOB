pipeline {

    agent {
        docker {
            image 'lokeshkanneboina7/devops-agent:latest'
            args '--entrypoint= -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        AWS_REGION   = "ap-south-2"
        ACCOUNT_ID   = "846345203699"
        CLUSTER_NAME = "realworld-eks"
        ECR_REGISTRY = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                deleteDir()
                git branch: 'main',
                    url: 'https://github.com/LOKESH734/Real_WORLD_JOB.git'
            }
        }

        stage('Set Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    echo "IMAGE_TAG = ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    set -e
                    docker --version
                    aws --version
                    kubectl version --client
                '''
            }
        }

        // ✅ IMPORTANT: Auto-scale cluster BEFORE build so URL is available
        stage('Ensure Cluster Capacity') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh '''
                        set -e

                        echo "🔍 Getting nodegroup name dynamically..."
                        NODEGROUP=$(aws eks list-nodegroups --cluster-name ${CLUSTER_NAME} --region ${AWS_REGION} --query 'nodegroups[0]' --output text)
                        echo "📦 Nodegroup: $NODEGROUP"

                        echo "📈 Scaling EKS Nodegroup..."
                        aws eks update-nodegroup-config \
                          --cluster-name ${CLUSTER_NAME} \
                          --nodegroup-name ${NODEGROUP} \
                          --scaling-config minSize=1,maxSize=3,desiredSize=2 \
                          --region ${AWS_REGION}

                        echo "⏳ Waiting for nodes to be ready..."
                        sleep 90

                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                        echo "⏳ Waiting for all nodes to be Ready..."
                        kubectl wait --for=condition=Ready nodes --all --timeout=180s || true

                        echo "✅ Nodes status:"
                        kubectl get nodes
                    '''
                }
            }
        }

        stage('Get Ingress URL') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    script {
                        sh 'aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}'

                        // Get existing ingress URL if already deployed
                        def ingressUrl = sh(
                            script: "kubectl get ingress app-ingress -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo ''",
                            returnStdout: true
                        ).trim()

                        if (ingressUrl) {
                            env.REACT_APP_API_URL = "http://${ingressUrl}"
                            echo "✅ Using existing Ingress URL: ${env.REACT_APP_API_URL}"
                        } else {
                            // Apply ingress first to get URL, then build frontend
                            sh 'kubectl apply -f K8s/ingress.yaml || true'
                            echo "⏳ Waiting for ALB to be provisioned..."
                            sh '''
                                for i in $(seq 1 20); do
                                    URL=$(kubectl get ingress app-ingress -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null)
                                    if [ ! -z "$URL" ]; then
                                        echo "GOT_URL=$URL"
                                        break
                                    fi
                                    echo "Waiting... ($i/20)"
                                    sleep 15
                                done
                            '''
                            ingressUrl = sh(
                                script: "kubectl get ingress app-ingress -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'",
                                returnStdout: true
                            ).trim()
                            env.REACT_APP_API_URL = "http://${ingressUrl}"
                            echo "✅ Got new Ingress URL: ${env.REACT_APP_API_URL}"
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    set -e
                    echo "🔨 Building backend..."
                    docker build -t backend:${IMAGE_TAG} realWordJob

                    echo "🔨 Building frontend with API URL: ${REACT_APP_API_URL}"
                    docker build \
                      --build-arg REACT_APP_API_URL=${REACT_APP_API_URL} \
                      -t frontend:${IMAGE_TAG} job-portal-frontend69
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh '''
                        set -e

                        aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login --username AWS --password-stdin ${ECR_REGISTRY}

                        docker tag backend:${IMAGE_TAG} ${ECR_REGISTRY}/backend:${IMAGE_TAG}
                        docker tag frontend:${IMAGE_TAG} ${ECR_REGISTRY}/frontend:${IMAGE_TAG}

                        docker push ${ECR_REGISTRY}/backend:${IMAGE_TAG}
                        docker push ${ECR_REGISTRY}/frontend:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh '''
                        set -e

                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                        echo "🚀 Applying Kubernetes manifests..."
                        kubectl apply -f K8s/

                        echo "🔄 Updating images..."
                        kubectl set image deployment/backend backend=${ECR_REGISTRY}/backend:${IMAGE_TAG}
                        kubectl set image deployment/frontend frontend=${ECR_REGISTRY}/frontend:${IMAGE_TAG}

                        echo "⏳ Waiting for rollout..."
                        kubectl rollout status deployment/backend --timeout=300s
                        kubectl rollout status deployment/frontend --timeout=300s
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh '''
                        set -e

                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                        echo "🔍 Pods:"
                        kubectl get pods -o wide

                        echo "🌐 Services:"
                        kubectl get svc

                        echo "📦 Deployments:"
                        kubectl get deployments

                        echo "🌐 Ingress:"
                        kubectl get ingress
                    '''
                }
            }
        }

        stage('Get Application URL') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh '''
                        set -e

                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                        echo "⏳ Waiting for Ingress URL..."

                        for i in $(seq 1 30); do
                            INGRESS_URL=$(kubectl get ingress -o jsonpath='{.items[0].status.loadBalancer.ingress[0].hostname}')

                            if [ ! -z "$INGRESS_URL" ]; then
                                echo "======================================="
                                echo "🚀 APPLICATION LIVE:"
                                echo "http://$INGRESS_URL"
                                echo "======================================="
                                exit 0
                            fi

                            echo "Waiting... ($i/30)"
                            sleep 10
                        done

                        echo "❌ Ingress not ready"
                        exit 1
                    '''
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    docker rmi backend:${IMAGE_TAG} || true
                    docker rmi frontend:${IMAGE_TAG} || true
                '''
            }
        }
    }

    post {

        success {
            echo "🚀 CI/CD SUCCESS – FULLY AUTOMATED DEPLOYMENT DONE"
        }

        failure {
            withCredentials([[
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-creds'
            ]]) {
                sh '''
                    aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME} || true

                    echo "🔍 Debugging Info"
                    kubectl get pods || true
                    kubectl describe pods || true

                    echo "📜 Backend Logs:"
                    kubectl logs -l app=backend --tail=50 || true

                    echo "📜 Frontend Logs:"
                    kubectl logs -l app=frontend --tail=50 || true
                '''
            }
            echo "❌ Deployment Failed – Check logs above"
        }
    }
}