pipeline {

    agent {
        docker {
            image 'lokeshkanneboina7/devops-agent:latest'
            args '--entrypoint="" -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        AWS_REGION   = "ap-south-2"
        ACCOUNT_ID   = "846345203699"
        CLUSTER_NAME = "realworld-eks"
        ECR_REGISTRY = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                deleteDir()
                git branch: 'main',
                    url: 'https://github.com/LOKESH734/Real_WORLD_JOB.git'
            }
        }

        stage('Set Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    echo "IMAGE_TAG = ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    docker --version
                    aws --version
                    kubectl version --client
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh """
                    docker build -t backend:${IMAGE_TAG} realWordJob
                    docker build -t frontend:${IMAGE_TAG} job-portal-frontend69
                """
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login --username AWS --password-stdin ${ECR_REGISTRY}

                        docker tag backend:${IMAGE_TAG} ${ECR_REGISTRY}/backend:${IMAGE_TAG}
                        docker tag frontend:${IMAGE_TAG} ${ECR_REGISTRY}/frontend:${IMAGE_TAG}

                        docker push ${ECR_REGISTRY}/backend:${IMAGE_TAG}
                        docker push ${ECR_REGISTRY}/frontend:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh """
                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                        echo "🚀 Applying core Kubernetes resources..."

                        # Apply all YAML except ServiceMonitor
                        for file in K8s/*.yaml; do
                            if [[ "\$file" != *servicemonitor.yaml ]]; then
                                echo "Applying \$file"
                                kubectl apply -f \$file
                            fi
                        done

                        echo "⏳ Waiting for cluster stability..."
                        sleep 20

                        echo "🔍 Checking ServiceMonitor CRD..."
                        if kubectl get crd servicemonitors.monitoring.coreos.com >/dev/null 2>&1; then
                            echo "✅ CRD exists → applying ServiceMonitor"
                            kubectl apply -f K8s/backend-servicemonitor.yaml
                        else
                            echo "⚠️ CRD NOT found → skipping ServiceMonitor"
                        fi

                        echo "🚀 Waiting for rollout..."
                        kubectl rollout status deployment/backend --timeout=180s
                        kubectl rollout status deployment/frontend --timeout=180s
                    """
                }
            }
        }

     stage('Verify Deployment') {
    steps {
        withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-creds'
        ]]) {
            sh """
                aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                echo "🔍 Verifying pods..."

                kubectl get pods -l app=backend
                kubectl get pods -l app=frontend

                echo "✅ Deployment Verified"
            """
        }
    }
}


        stage('Cleanup') {
            steps {
                sh """
                    docker rmi backend:${IMAGE_TAG} || true
                    docker rmi frontend:${IMAGE_TAG} || true
                    docker rmi ${ECR_REGISTRY}/backend:${IMAGE_TAG} || true
                    docker rmi ${ECR_REGISTRY}/frontend:${IMAGE_TAG} || true
                """
            }
        }
    }

    post {
        success {
            echo "🚀 CI/CD SUCCESS – App Deployed Successfully"
        }
        failure {
            echo "❌ Deployment Failed – Investigate Immediately"
        }
    }
}
